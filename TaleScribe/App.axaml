<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TaleScribe.App"
             xmlns:local="using:TaleScribe"
             RequestedThemeVariant="Light">
             <!-- Light mode only: the design system has no dark theme and does not follow the system. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <!-- The design system: tokens first, since the themes and styles below look them up. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Styles/Tokens.axaml" />
                <ResourceInclude Source="/Styles/Themes.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="/Styles/Typography.axaml" />
        <StyleInclude Source="/Styles/Controls.axaml" />
    </Application.Styles>
</Application>
