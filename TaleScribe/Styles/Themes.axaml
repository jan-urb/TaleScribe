<!-- Control themes for the design system. Button, RadioButton, Slider and ComboBox replace Fluent's themes
     outright (implicit, keyed by type), so no Fluent hover, pressed or accent colors leak through. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">

    <!-- Buttons. Default is Secondary S; classes pick the rest:
           primary · destructive · destructive primary (confirm dialogs only) · text [positive|destructive]
           m / l for size · record (primary with a live dot) · rowButton (a whole list row) · play -->
    <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderControlBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource Ink70Brush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
                <BrushTransition Property="Foreground" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      RecognizesAccessKey="True" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{StaticResource FillHoverBrush}" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_Border">
            <Setter Property="BoxShadow" Value="{StaticResource FocusRing}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>

        <!-- Sizes: S is the default (rows, dialogs, footers), M for page headers, L for hero actions -->
        <Style Selector="^.m">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="16,0" />
        </Style>
        <Style Selector="^.l">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="22,0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontSize" Value="13.5" />
        </Style>

        <Style Selector="^.primary">
            <Setter Property="Background" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style Selector="^.primary:pointerover">
            <Setter Property="Background" Value="{StaticResource InkHoverBrush}" />
        </Style>

        <Style Selector="^.destructive">
            <Setter Property="BorderBrush" Value="{StaticResource RedBorderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
        </Style>
        <Style Selector="^.destructive.primary">
            <Setter Property="Background" Value="{StaticResource RedBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="^.destructive.primary:pointerover">
            <Setter Property="Background" Value="{StaticResource RedBrush}" />
        </Style>

        <!-- Record: a primary button with a live dot before the label -->
        <Style Selector="^.record">
            <Setter Property="ContentTemplate">
                <DataTemplate x:DataType="sys:String">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="7" Height="7"
                                 Fill="{StaticResource RedLiveBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </Setter>
        </Style>

        <!-- Text actions: no chrome, never underlined; hover goes one alpha step darker -->
        <Style Selector="^.text">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Height" Value="NaN" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Ink50Brush}" />
        </Style>
        <Style Selector="^.text:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Ink60Brush}" />
        </Style>
        <Style Selector="^.text.positive, ^.text.positive:pointerover">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style Selector="^.text.destructive, ^.text.destructive:pointerover">
            <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
        </Style>

        <!-- A whole list row that opens something -->
        <Style Selector="^.rowButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Height" Value="NaN" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="^.rowButton:pointerover">
            <Setter Property="Background" Value="{StaticResource FillHoverBrush}" />
        </Style>

        <!-- Back link at the top of a page: a text action, sized up to be an easy target -->
        <Style Selector="^.text.back">
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="Padding" Value="0,4" />
        </Style>

        <!-- Player: 24px ink circle holding a white glyph -->
        <Style Selector="^.play">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{StaticResource InkBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="^.play:pointerover">
            <Setter Property="Background" Value="{StaticResource InkHoverBrush}" />
        </Style>
    </ControlTheme>

    <!-- Radio: 14px ring; selected is an ink disc with a 5px white centre -->
    <ControlTheme x:Key="{x:Type RadioButton}" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="Auto,*" Background="{TemplateBinding Background}">
                    <Panel Width="14" Height="14" VerticalAlignment="Center">
                        <Ellipse Name="Ring" Stroke="{StaticResource RadioRingBrush}" StrokeThickness="1.5" />
                        <Ellipse Name="Disc" Fill="{StaticResource InkBrush}" IsVisible="False" />
                        <Ellipse Name="Centre" Width="5" Height="5" Fill="White" IsVisible="False" />
                    </Panel>
                    <ContentPresenter Grid.Column="1"
                                      Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}"
                                      Margin="8,0,0,0"
                                      VerticalAlignment="Center" />
                </Grid>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:checked /template/ Ellipse#Ring">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:checked /template/ Ellipse#Disc">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:checked /template/ Ellipse#Centre">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.45" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
    </ControlTheme>

    <!-- Scrubber: a 2px track line with an ink fill. The thumb only shows on hover. -->
    <ControlTheme x:Key="ScrubberRepeatButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="Transparent">
                    <Border Height="2"
                            CornerRadius="2"
                            Background="{TemplateBinding Background}"
                            VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="ScrubberThumb" TargetType="Thumb">
        <Setter Property="Template">
            <ControlTemplate>
                <Ellipse Width="10" Height="10" Fill="{StaticResource InkBrush}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type Slider}" TargetType="Slider">
        <Setter Property="Background" Value="{StaticResource TrackBrush}" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="MinHeight" Value="16" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Background="Transparent">
                    <!-- The full track sits behind the Track, so the hidden thumb leaves no gap -->
                    <Border Height="2"
                            CornerRadius="2"
                            Background="{TemplateBinding Background}"
                            VerticalAlignment="Center" />
                    <Track Name="PART_Track"
                           Orientation="Horizontal"
                           Minimum="{TemplateBinding Minimum}"
                           Maximum="{TemplateBinding Maximum}"
                           Value="{TemplateBinding Value, Mode=TwoWay}"
                           IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                        <Track.DecreaseButton>
                            <RepeatButton Name="PART_DecreaseButton"
                                          Theme="{StaticResource ScrubberRepeatButton}"
                                          Background="{TemplateBinding Foreground}" />
                        </Track.DecreaseButton>
                        <Track.IncreaseButton>
                            <RepeatButton Name="PART_IncreaseButton"
                                          Theme="{StaticResource ScrubberRepeatButton}"
                                          Background="Transparent" />
                        </Track.IncreaseButton>
                        <Thumb Name="thumb" Theme="{StaticResource ScrubberThumb}" Opacity="0" />
                    </Track>
                </Grid>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ Thumb#thumb">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.45" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
    </ControlTheme>

    <!-- Select: 30px, hairline border, trailing ▾. The popup is a floating surface, the only place
         with elevation; its margin leaves room in the popup window for the shadow, and the offset
         keeps the list lined up with the box. -->
    <ControlTheme x:Key="{x:Type ComboBox}" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderControlBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="MaxDropDownHeight" Value="320" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Name="Background"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}" />
                    <Grid ColumnDefinitions="*,Auto" Margin="{TemplateBinding Padding}">
                        <TextBlock Name="PlaceholderTextBlock"
                                   Text="{TemplateBinding PlaceholderText}"
                                   Foreground="{StaticResource Ink30Brush}"
                                   VerticalAlignment="Center"
                                   IsVisible="{TemplateBinding SelectionBoxItem, Converter={x:Static ObjectConverters.IsNull}}" />
                        <ContentControl Name="ContentPresenter"
                                        Content="{TemplateBinding SelectionBoxItem}"
                                        ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="▾"
                                   FontSize="9"
                                   Foreground="{StaticResource Ink30Brush}"
                                   Margin="9,0,0,0"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <Popup Name="PART_Popup"
                           WindowManagerAddShadowHint="False"
                           IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                           MaxHeight="{TemplateBinding MaxDropDownHeight}"
                           PlacementTarget="Background"
                           HorizontalOffset="-10"
                           VerticalOffset="4"
                           IsLightDismissEnabled="True"
                           InheritsTransform="True">
                        <Border Name="PopupBorder"
                                MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource ElevatedBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="4"
                                Margin="10,0,10,24"
                                BoxShadow="{StaticResource ElevationShadow}">
                            <ScrollViewer HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                                          VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}">
                                <ItemsPresenter Name="PART_ItemsPresenter"
                                                ItemsPanel="{TemplateBinding ItemsPanel}" />
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{StaticResource FillHoverBrush}" />
        </Style>
        <Style Selector="^:dropdownopen, ^:focus-within">
            <Setter Property="BorderBrush" Value="{StaticResource BorderFocusBrush}" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#Background">
            <Setter Property="BoxShadow" Value="{StaticResource FocusRing}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.45" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
    </ControlTheme>

    <!-- Sidebar navigation item -->
    <ControlTheme x:Key="NavItemTheme" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Ink60Brush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="7"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{StaticResource FillHoverBrush}" />
        </Style>
        <Style Selector="^:selected, ^:selected:pointerover">
            <Setter Property="Background" Value="{StaticResource FillSelectedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
