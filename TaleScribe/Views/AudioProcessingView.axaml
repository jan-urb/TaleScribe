<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:TaleScribe.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:RecordingFlowViewModel"
             x:Class="TaleScribe.Views.AudioProcessingView">

    <!-- Centred on both axes -->
    <StackPanel Width="360"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
            <Ellipse Classes="workingDot" />
            <TextBlock Classes="titleLg" Text="Transcribing" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Classes="subtitle"
                   Text="Everything runs on this machine. Long recordings take a while."
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0" />

        <!-- The transcriber reports no progress, so the bar only shows that work is going on -->
        <ProgressBar IsIndeterminate="True" Margin="0,24,0,0" />

        <Button Classes="text destructive"
                Content="Cancel"
                Command="{Binding CancelProcessingCommand}"
                Margin="0,24,0,0"
                HorizontalAlignment="Center" />

    </StackPanel>
</UserControl>
