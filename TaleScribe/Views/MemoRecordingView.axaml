<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:TaleScribe.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="620"
             x:DataType="vm:MemoViewModel"
             x:Class="TaleScribe.Views.MemoRecordingView">

    <DockPanel LastChildFill="True">

        <!-- Footer: what the microphone is doing on the left, actions on the right -->
        <Border DockPanel.Dock="Bottom" Classes="footerBar">
            <Grid ColumnDefinitions="*,Auto">

                <Panel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Classes="caption" Text="Hold the button to talk" IsVisible="{Binding !IsRunning}" />

                    <!-- Held down: the microphone is live -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <StackPanel.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="IsRunning" />
                                <Binding Path="!StopCommand.IsRunning" />
                            </MultiBinding>
                        </StackPanel.IsVisible>
                        <Ellipse Classes="liveDot" />
                        <TextBlock Classes="status" Text="Listening" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Released: the press is being transcribed -->
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding StopCommand.IsRunning}">
                        <Ellipse Classes="workingDot" />
                        <TextBlock Classes="status" Text="Transcribing…" VerticalAlignment="Center" />
                    </StackPanel>
                </Panel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <Button Classes="text destructive" Content="Clear" Command="{Binding ResetCommand}" />
                    <Button Content="Copy text" Click="CopyButton_Click" />

                    <Button x:Name="MemoButton"
                            Classes="primary record"
                            Content="Hold to talk"
                            IsEnabled="{Binding !StopCommand.IsRunning}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Spoken text -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <SelectableTextBlock x:Name="MemoBlock"
                                 Classes="reading"
                                 Text="{Binding Result}"
                                 MaxWidth="640"
                                 HorizontalAlignment="Left"
                                 Margin="40,32,40,32" />
        </ScrollViewer>

    </DockPanel>
</UserControl>
